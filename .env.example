# Copy to .env for local development. On Render, set these as Environment Variables
# in the service's Environment tab -- never commit real values.

# Airtable personal access token.
# Create at https://airtable.com/create/tokens with these scopes, scoped to the
# "Fraaash Ads" base ONLY:
#   data.records:read
#   data.records:write
#   schema.bases:read
AIRTABLE_TOKEN=patXXXXXXXXXXXXXX.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# The "Fraaash Ads" base. This default is already correct; override only if the base changes.
AIRTABLE_BASE_ID=appp3bMk7dH0pD5XO

# Render supplies PORT automatically. Only needed locally.
PORT=3000

# Password for the dashboard. Any username is accepted; only this is checked.
# The browser remembers it, so it is typed once per device.
# LEAVE THIS UNSET AND THE SITE IS OPEN TO ANYONE WITH THE URL.
DASHBOARD_PASSWORD=choose-something-long
